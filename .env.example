# WebSocket URL of the relay (http/https are upgraded to ws/wss).
RELAY_URL=wss://relay.example.com

# Bot identity — the same key the agent signs with. Hex or nsec.
# Prefer a root-only file / systemd LoadCredential. Never commit the secret.
# BOT_PRIVATE_KEY=nsec1...
BOT_PRIVATE_KEY_FILE=grokbot_ears_key

# Optional. Hex or npub. If set, must match the pubkey derived from the private key.
# BOT_PUBKEY=npub1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqhs6j2we

# Where to POST mention payloads.
WEBHOOK_URL=https://webhook.example.com/hook

# Optional. If set, the process sends:
#   Authorization: Bearer <value>
#   X-Automation-Key: <value>
# If unset, no auth headers are sent — use this when an egress proxy injects them.
# WEBHOOK_BEARER=

WEBHOOK_TIMEOUT_MS=8000

# How often to re-query kind:39002 membership (milliseconds). Default 60000.
REDISCOVERY_INTERVAL_MS=60000

# Also subscribe to forum kinds 45001 and 45003.
INCLUDE_FORUM_KINDS=false

# Also subscribe to ACP stream kinds 46010 and 40007. Off by default.
INCLUDE_ACP_STREAM_KINDS=false

# Persist last-seen created_at (unix seconds) across restarts.
# STATE_FILE=./state.txt

# If set, serve GET /healthz on this port.
# HEALTH_PORT=8080
